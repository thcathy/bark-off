{
  "expo": {
    "name": "Bark Off Dog",
    "slug": "bark-off",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "barkoff",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.thcathy.barkoff",
      "appleTeamId": "DU483K8F48",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "locales": {
      "en": "./languages/en.json",
      "zh-HK": "./languages/zh-HK.json",
      "zh-Hans": "./languages/zh-Hans.json",
      "zh-CN": "./languages/zh-Hans.json"
    },
    "android": {
      "package": "com.thcathy.barkoff",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#65B1FC"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#65B1FC",
          "image": "./assets/icon.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Bark Off Dog uses the microphone to record your own scare sound."
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "zh-HK",
              "zh-Hans"
            ],
            "android": [
              "en",
              "zh-HK",
              "zh-CN"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
